# Hoy simulator.py emite progreso vía utils.emit_progress() que hace print()
# → funciona para subproceso local (stdout se redirige en Unity)
# → NO funciona para servidor persistente (FastAPI no lee stdout)
#
# Solución: registrar un callback que simulator.py llamará en cada paso
# El servidor FastAPI lo conectará a una cola que SSE consumirá
#
# ANTES (hoy):
#   def run(params):
#       ...
#       utils.emit_progress({"status": "running", "current": i})  # print → stdout
#
# DESPUÉS (lo que escribes):
#   progress_callback = None
#   def set_progress_callback(fn):
#       global progress_callback
#       progress_callback = fn
#
#   def run(params):
#       ...
#       if progress_callback:
#           progress_callback({"status": "running", "current": i})
#       else:
#           utils.emit_progress(...)  # fallback para CLI

# ============================================================================
# TAREAS
# ============================================================================

# 1. En simulator.py, agregar esta variable global (al inicio del archivo)
#    después de los imports:

progress_callback = None

def set_progress_callback(fn):
    """
    Registra un callback que se llama cada vez que hay progreso.

    Parámetros:
        fn: función(payload: dict) que recibe línea de progreso

    Ejemplo:
        def mi_callback(line):
            print(f"Progreso: {line}")

        set_progress_callback(mi_callback)
    """
    global progress_callback
    progress_callback = fn


# 2. En simulator.py, reemplazar cada llamada a utils.emit_progress() con:

def _emit_progress(payload):
    """
    Emite progreso al callback registrado, o fallback a stdout (CLI).
    """
    if progress_callback:
        progress_callback(payload)
    else:
        # Fallback para ejecución CLI (cuando no hay callback registrado)
        utils.emit_progress(payload)


# 3. Actualizar run() para usar _emit_progress() en lugar de utils.emit_progress()
