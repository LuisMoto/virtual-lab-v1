# 4. En utils.py, agregar esta función auxiliar (para uso en FastAPI):

def create_progress_queue():
    """
    Crea una cola thread-safe para pasar progreso del simulador al servidor SSE.

    Retorna:
        (queue.Queue, callback_function)

    Ejemplo de uso en server.py:
        progress_queue, progress_callback = utils.create_progress_queue()
        simulator.set_progress_callback(progress_callback)

        # Después, en el handler SSE:
        while True:
            try:
                line = progress_queue.get(timeout=0.5)
                yield f"data: {json.dumps(line)}\\n\\n"
            except queue.Empty:
                pass
    """
    import queue
    import threading

    q = queue.Queue()

    def callback(payload):
        q.put(payload)

    return q, callback


