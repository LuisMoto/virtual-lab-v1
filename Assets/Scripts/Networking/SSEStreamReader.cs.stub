// 2. Usar TCP directo vía System.Net.Sockets:
//    socket.Connect("localhost", 8000);
//    socket.Send(encoding.GetBytes("GET /simulate/stream HTTP/1.1\r\n..."));
//    StreamReader reader = new StreamReader(socket.InputStream);
//    while ((line = reader.ReadLine()) != null) {
//        ProcessLine(line);
//    }
//
// 3. Timer que consulta /simulate/progress cada N ms (simple, menos ideal):
//    En server.py guardar progreso en variable global
//    GET /simulate/progress retorna estado actual
//
// Para esta semana, recomendación: opción 2 (System.Net.Sockets) es más
// confiable que el polling personalizado. Si tienes problemas,
// avisa temprano en la semana.

